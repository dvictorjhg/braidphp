{
    "name": "dvictorjhg/braidphp",
    "type": "library",
    "description": "An attribute-driven PHP framework with a router and lightweight single-process TCP HTTP runtime.",
    "keywords": [
        "dvictorjhg",
        "braidphp"
    ],
    "homepage": "https://github.com/dvictorjhg/braidphp",
    "license": "Apache-2.0",
    "authors": [
        {
            "name": "Víctor José Holgado Gallegos",
            "email": "vihoga@hotmail.es",
            "homepage": "https://github.com/dvictorjhg",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/dvictorjhg/braidphp/issues",
        "source": "https://github.com/dvictorjhg/braidphp",
        "docs": "https://dvictorjhg.github.io/braidphp/"
    },
    "require": {
        "dvictorjhg/php-injector": "^1.0.1",
        "php": "^8.4",
        "psr/http-message": "^2.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.0",
        "squizlabs/php_codesniffer": "^3.0",
        "zalas/phpunit-globals": "^3.0"
    },
    "provide": {
        "psr/http-message-implementation": "2.0"
    },
    "autoload": {
        "psr-4": {
            "dvictorjhg\\braidphp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "dvictorjhg\\braidphp\\tests\\": "tests/",
            "dvictorjhg\\braidphp\\Example\\": "Example/"
        }
    },
    "archive": {
        "exclude": [
            "/Example/"
        ]
    },
    "scripts": {
        "analyse": "phpstan analyse --no-progress --memory-limit=512M",
        "test": "phpunit --no-coverage",
        "test:coverage": [
            "@php -r \"is_dir('build/test-results') || mkdir('build/test-results', 0777, true);\"",
            "@php -d xdebug.mode=coverage vendor/bin/phpunit --coverage-clover build/test-results/clover.xml --coverage-html build/test-results/coverage-html"
        ],
        "test-coverage": "@test:coverage",
        "coverage:check": "@php tools/check-coverage.php build/test-results/clover.xml 80",
        "check-style": "phpcs src Example tests",
        "fix-style": "phpcbf src Example tests"
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.0-dev"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
